<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login — Persian Darbar Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
        rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0f1117;
            position: relative;
            overflow: hidden;
        }

        /* Animated background gradient blobs */
        body::before,
        body::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.3;
        }

        body::before {
            width: 500px;
            height: 500px;
            background: #d35400;
            top: -150px;
            right: -100px;
            animation: float1 8s ease-in-out infinite;
        }

        body::after {
            width: 400px;
            height: 400px;
            background: #e67e22;
            bottom: -100px;
            left: -50px;
            animation: float2 10s ease-in-out infinite;
        }

        @keyframes float1 {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(-40px, 30px); }
        }

        @keyframes float2 {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(30px, -40px); }
        }

        .login-container {
            position: relative;
            z-index: 1;
            width: 90%;
            max-width: 420px;
        }

        .login-card {
            background: rgba(22, 24, 33, 0.85);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 48px 40px;
            box-shadow: 0 32px 64px rgba(0, 0, 0, 0.5);
            animation: cardIn 0.6s ease;
        }

        @keyframes cardIn {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .login-logo {
            text-align: center;
            margin-bottom: 36px;
        }

        .login-logo h1 {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            font-weight: 700;
            color: #fff;
        }

        .login-logo h1 span {
            color: #d35400;
        }

        .login-logo p {
            color: #666;
            font-size: 14px;
            margin-top: 8px;
        }

        .error-msg {
            background: rgba(231, 76, 60, 0.12);
            border: 1px solid rgba(231, 76, 60, 0.25);
            color: #e74c3c;
            padding: 12px 18px;
            border-radius: 10px;
            font-size: 14px;
            margin-bottom: 20px;
            text-align: center;
            animation: shake 0.4s ease;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-6px); }
            75% { transform: translateX(6px); }
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #777;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .form-group input {
            width: 100%;
            padding: 14px 18px;
            background: rgba(15, 17, 23, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            color: #e1e4ea;
            font-family: inherit;
            font-size: 15px;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-group input:focus {
            border-color: #d35400;
            box-shadow: 0 0 0 3px rgba(211, 84, 0, 0.15);
        }

        .form-group input::placeholder {
            color: #444;
        }

        .login-btn {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #d35400, #e67e22);
            border: none;
            border-radius: 10px;
            color: white;
            font-family: inherit;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 6px;
        }

        .login-btn:hover {
            background: linear-gradient(135deg, #e67e22, #f39c12);
            box-shadow: 0 8px 28px rgba(211, 84, 0, 0.4);
            transform: translateY(-1px);
        }

        .login-btn:active {
            transform: translateY(0);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 24px;
            color: #555;
            font-size: 14px;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: #d35400;
        }
    </style>
</head>

<body>

    <div class="login-container">
        <div class="login-card">

            <div class="login-logo">
                <h1>Persian Darbar<span>.</span></h1>
                <p>Admin Dashboard</p>
            </div>

            <% if (error) { %>
            <div class="error-msg">
                ⚠️ <%= error %>
            </div>
            <% } %>

            <form action="/admin/login" method="POST">

                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" name="email" placeholder="admin@persiandarbar.com" required>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="Enter your password" required>
                </div>

                <button type="submit" class="login-btn">
                    Sign In →
                </button>

            </form>

            <a href="/" class="back-link">← Back to Website</a>

        </div>
    </div>

</body>

</html>
