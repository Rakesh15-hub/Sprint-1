<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin — Persian Darbar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
        rel="stylesheet">
    <style>
        /* ============================================
           ADMIN DASHBOARD — PREMIUM DARK THEME
        ============================================ */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #0f1117;
            color: #e1e4ea;
            min-height: 100vh;
            display: flex;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* ---- SIDEBAR ---- */

        .sidebar {
            width: 270px;
            min-height: 100vh;
            background: #161821;
            border-right: 1px solid rgba(255, 255, 255, 0.06);
            padding: 32px 0;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
        }

        .sidebar-logo {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 700;
            padding: 0 28px;
            margin-bottom: 45px;
            color: #fff;
        }

        .sidebar-logo span {
            color: #d35400;
        }

        .sidebar-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #555;
            padding: 0 28px;
            margin-bottom: 14px;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 0 14px;
            flex: 1;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 13px 16px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 500;
            color: #9198a8;
            transition: all 0.2s ease;
        }

        .sidebar-nav a:hover {
            background: rgba(211, 84, 0, 0.08);
            color: #e1e4ea;
        }

        .sidebar-nav a.active {
            background: linear-gradient(135deg, rgba(211, 84, 0, 0.2), rgba(211, 84, 0, 0.08));
            color: #ff9850;
            font-weight: 600;
        }

        .sidebar-nav a .nav-icon {
            font-size: 20px;
            width: 28px;
            text-align: center;
        }

        .sidebar-nav a .badge {
            margin-left: auto;
            background: #d35400;
            color: white;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 20px;
            min-width: 22px;
            text-align: center;
        }

        .sidebar-bottom {
            padding: 0 14px;
            margin-top: 20px;
        }

        .sidebar-bottom form {
            margin: 0;
        }

        .sidebar-bottom button {
            display: flex;
            align-items: center;
            gap: 14px;
            width: 100%;
            padding: 13px 16px;
            border: none;
            border-radius: 10px;
            font-family: inherit;
            font-size: 15px;
            font-weight: 500;
            color: #9198a8;
            background: transparent;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .sidebar-bottom button:hover {
            background: rgba(255, 60, 60, 0.1);
            color: #ff6b6b;
        }

        /* ---- MAIN CONTENT ---- */

        .main-content {
            flex: 1;
            margin-left: 270px;
            padding: 36px 40px;
            min-height: 100vh;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 36px;
        }

        .page-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            font-weight: 700;
            color: #fff;
        }

        .page-header h1 span {
            color: #d35400;
        }

        .page-subtitle {
            color: #666;
            font-size: 14px;
            margin-top: 6px;
        }

        /* ---- CARDS ---- */

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 20px;
            margin-bottom: 36px;
        }

        .stat-card {
            background: #1a1d28;
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 14px;
            padding: 26px;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            border-color: rgba(211, 84, 0, 0.3);
            transform: translateY(-2px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .stat-card .stat-icon {
            font-size: 28px;
            margin-bottom: 16px;
        }

        .stat-card .stat-value {
            font-size: 34px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 6px;
        }

        .stat-card .stat-label {
            font-size: 14px;
            color: #666;
        }

        /* ---- TABLE ---- */

        .admin-table-wrap {
            background: #1a1d28;
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 30px;
        }

        .admin-table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px 26px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .admin-table-header h2 {
            font-size: 18px;
            font-weight: 600;
            color: #fff;
            font-family: 'DM Sans', sans-serif;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            text-align: left;
            padding: 14px 26px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #555;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        tbody td {
            padding: 16px 26px;
            font-size: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            vertical-align: middle;
        }

        tbody tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        /* ---- BADGES ---- */

        .badge-status {
            display: inline-block;
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-success {
            background: rgba(46, 204, 113, 0.15);
            color: #2ecc71;
        }

        .badge-warning {
            background: rgba(241, 196, 15, 0.15);
            color: #f1c40f;
        }

        .badge-danger {
            background: rgba(231, 76, 60, 0.15);
            color: #e74c3c;
        }

        .badge-info {
            background: rgba(52, 152, 219, 0.15);
            color: #3498db;
        }

        /* ---- BUTTONS ---- */

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #d35400, #e67e22);
            color: white;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #e67e22, #f39c12);
            box-shadow: 0 4px 18px rgba(211, 84, 0, 0.35);
        }

        .btn-sm {
            padding: 7px 14px;
            font-size: 12px;
        }

        .btn-success {
            background: rgba(46, 204, 113, 0.15);
            color: #2ecc71;
            border: 1px solid rgba(46, 204, 113, 0.2);
        }

        .btn-success:hover {
            background: rgba(46, 204, 113, 0.25);
        }

        .btn-danger {
            background: rgba(231, 76, 60, 0.15);
            color: #e74c3c;
            border: 1px solid rgba(231, 76, 60, 0.2);
        }

        .btn-danger:hover {
            background: rgba(231, 76, 60, 0.25);
        }

        .btn-warning {
            background: rgba(241, 196, 15, 0.15);
            color: #f1c40f;
            border: 1px solid rgba(241, 196, 15, 0.2);
        }

        .btn-warning:hover {
            background: rgba(241, 196, 15, 0.25);
        }

        .btn-ghost {
            background: rgba(255, 255, 255, 0.05);
            color: #9198a8;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .btn-ghost:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #e1e4ea;
        }

        .action-btns {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .action-btns form {
            display: inline;
        }

        /* ---- FORMS ---- */

        .admin-form {
            background: #1a1d28;
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 14px;
            padding: 30px;
            margin-bottom: 30px;
        }

        .admin-form h2 {
            font-size: 18px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 22px;
            font-family: 'DM Sans', sans-serif;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: #777;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 12px 16px;
            background: #0f1117;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            color: #e1e4ea;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: #d35400;
        }

        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }

        .form-group select {
            appearance: none;
            cursor: pointer;
        }

        .form-actions {
            margin-top: 20px;
            display: flex;
            gap: 12px;
        }

        /* ---- ALERTS ---- */

        .alert {
            padding: 14px 22px;
            border-radius: 10px;
            margin-bottom: 22px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: slideDown 0.3s ease;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert-success {
            background: rgba(46, 204, 113, 0.12);
            border: 1px solid rgba(46, 204, 113, 0.2);
            color: #2ecc71;
        }

        .alert-error {
            background: rgba(231, 76, 60, 0.12);
            border: 1px solid rgba(231, 76, 60, 0.2);
            color: #e74c3c;
        }

        /* ---- FOOD IMAGE IN TABLE ---- */

        .table-img {
            width: 55px;
            height: 55px;
            border-radius: 8px;
            object-fit: cover;
        }

        /* ---- STARS ---- */

        .stars {
            color: #f39c12;
            letter-spacing: 2px;
        }

        /* ---- EMPTY STATE ---- */

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #555;
        }

        .empty-state .empty-icon {
            font-size: 48px;
            margin-bottom: 16px;
        }

        .empty-state p {
            font-size: 15px;
        }

        /* ---- MODAL (Edit) ---- */

        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            background: #1a1d28;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 32px;
            width: 90%;
            max-width: 550px;
            max-height: 90vh;
            overflow-y: auto;
            animation: modalIn 0.3s ease;
        }

        @keyframes modalIn {
            from {
                opacity: 0;
                transform: scale(0.95) translateY(10px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .modal h2 {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 24px;
            font-family: 'DM Sans', sans-serif;
        }

        .modal-close {
            float: right;
            background: none;
            border: none;
            color: #666;
            font-size: 24px;
            cursor: pointer;
            padding: 4px;
        }

        .modal-close:hover {
            color: #e74c3c;
        }

        /* ---- RESPONSIVE ---- */

        @media (max-width: 900px) {
            .sidebar {
                width: 70px;
                padding: 20px 0;
            }

            .sidebar-logo,
            .sidebar-label,
            .sidebar-nav a span:not(.nav-icon),
            .sidebar-nav a .badge,
            .sidebar-bottom button span {
                display: none;
            }

            .sidebar-nav a {
                justify-content: center;
                padding: 14px;
            }

            .sidebar-bottom button {
                justify-content: center;
                padding: 14px;
            }

            .main-content {
                margin-left: 70px;
                padding: 24px 20px;
            }
        }

        @media (max-width: 600px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .admin-table-wrap {
                overflow-x: auto;
            }
        }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            Persian Darbar<span>.</span>
        </div>

        <div class="sidebar-label">Management</div>

        <nav class="sidebar-nav">
            <a href="/admin/dashboard" class="<%= typeof page !== 'undefined' && page === 'dashboard' ? 'active' : '' %>">
                <span class="nav-icon">📊</span>
                <span>Dashboard</span>
            </a>

            <a href="/admin/orders" class="<%= typeof page !== 'undefined' && page === 'orders' ? 'active' : '' %>">
                <span class="nav-icon">🛍️</span>
                <span>Orders</span>
            </a>

            <a href="/admin/menu" class="<%= typeof page !== 'undefined' && page === 'menu' ? 'active' : '' %>">
                <span class="nav-icon">🍽️</span>
                <span>Menu Items</span>
            </a>

            <a href="/admin/reviews" class="<%= typeof page !== 'undefined' && page === 'reviews' ? 'active' : '' %>">
                <span class="nav-icon">⭐</span>
                <span>Reviews</span>
            </a>

            <a href="/admin/contacts" class="<%= typeof page !== 'undefined' && page === 'contacts' ? 'active' : '' %>">
                <span class="nav-icon">✉️</span>
                <span>Messages</span>
            </a>

            <a href="/" target="_blank">
                <span class="nav-icon">🌐</span>
                <span>View Website</span>
            </a>
        </nav>

        <div class="sidebar-bottom">
            <form action="/admin/logout" method="POST">
                <button type="submit">
                    <span class="nav-icon">🚪</span>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">
